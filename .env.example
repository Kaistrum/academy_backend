# ---- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- database --------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kaistrum_academy

# ---- urls ------------------------------------------------------------------
# API_URL is used to build OAuth redirect URIs; APP_URL is the frontend.
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
BCRYPT_ROUNDS=12

# Cookie flags for the refresh token. Use secure=true and samesite=none only if
# the API and the frontend live on different sites (then HTTPS is mandatory).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.kaistrum.com

# ---- oauth (optional — buttons hide when unset) -----------------------------
# Google redirect URI:  {API_URL}/api/v1/auth/oauth/google/callback
# GitHub redirect URI:  {API_URL}/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- paystack (optional — checkout 503s when unset) -------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/checkout/callback
CURRENCY=KES

# ---- mail (optional — links print to the console when unset) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Kaistrum Academy <no-reply@kaistrum.com>

# ---- limits ----------------------------------------------------------------
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- seed script -----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@kaistrum.com
SEED_ADMIN_PASSWORD=Admin12345
