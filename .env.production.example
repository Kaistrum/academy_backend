# Production template for the Docker stack. On the VPS:
#
#   cp .env.production.example .env && $EDITOR .env
#
# docker compose reads this file twice: to interpolate ${...} in
# docker-compose.yml, and to inject the variables into the API container.

# ---- runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=4000

# ---- docker ----------------------------------------------------------------
# Hostname Caddy requests a certificate for (only used with --profile proxy).
API_DOMAIN=api.kaistrum.com

# Credentials for the bundled MongoDB container. Change both before first boot:
# they are baked into the volume the first time mongo starts.
MONGO_ROOT_USER=kaistrum
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string

# Leave this unset to use the bundled mongo container. Set it to run against a
# managed cluster instead, e.g.
#   MONGODB_URI_EXTERNAL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true
# (compose always sets the container's own MONGODB_URI, so a value for that name
# in this file is ignored — use MONGODB_URI_EXTERNAL.)
# MONGODB_URI_EXTERNAL=
MONGODB_DB=kaistrum_academy

# ---- urls ------------------------------------------------------------------
# API_URL builds the OAuth redirect URIs; APP_URL is the Vercel deployment and
# is where OAuth callbacks and email links land.
API_URL=https://api.kaistrum.com
APP_URL=https://academy.kaistrum.com

# Exact-match allow-list. Include every origin the browser will call from —
# the Vercel production domain, any custom domain aliased to it, and (only if
# you need them) specific preview URLs. Wildcards are not expanded.
CORS_ORIGINS=https://academy.kaistrum.com,https://kaistrum-academy.vercel.app

# ---- auth ------------------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
BCRYPT_ROUNDS=12

# The API and the front end are on different sites (Vercel vs your VPS), so the
# refresh cookie must be SameSite=None and Secure. Both require HTTPS.
# COOKIE_DOMAIN must stay unset: a cookie cannot be shared across sites.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ---- oauth (optional — buttons hide when unset) -----------------------------
# Register these redirect URIs with the provider:
#   {API_URL}/api/v1/auth/oauth/google/callback
#   {API_URL}/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- paystack (optional — checkout 503s when unset) -------------------------
# Webhook URL for the Paystack dashboard: {API_URL}/api/v1/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://academy.kaistrum.com/checkout/callback
CURRENCY=KES

# ---- mail (optional — links print to the container log when unset) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Kaistrum Academy <no-reply@kaistrum.com>

# ---- limits ----------------------------------------------------------------
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- seed script -----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@kaistrum.com
SEED_ADMIN_PASSWORD=change-me-before-seeding
